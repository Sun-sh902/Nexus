{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Bundled main window: application metadata, enum-bound UI preferences, and the typed Nexus domain commands (queries and plan/confirm intents). No shell, filesystem, dialog, or HTTP permissions are granted to the renderer.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-metadata",
    "allow-apply-app-preferences",
    "allow-nexus-overview",
    "allow-nexus-agent-history",
    "allow-nexus-models",
    "allow-nexus-create-provider",
    "allow-nexus-set-provider-secret",
    "allow-nexus-delete-provider",
    "allow-nexus-check-provider",
    "allow-nexus-create-model",
    "allow-nexus-delete-model",
    "allow-nexus-save-profile",
    "allow-nexus-delete-profile",
    "allow-nexus-set-assignment",
    "allow-nexus-prepare-action",
    "allow-nexus-confirm-plan",
    "allow-nexus-discard-plan",
    "allow-nexus-launch-agent",
    "allow-nexus-storage-status",
    "allow-nexus-prune-history",
    "allow-nexus-diagnostic-preview",
    "allow-nexus-list-workspaces",
    "allow-nexus-create-workspace",
    "allow-nexus-delete-workspace",
    "allow-nexus-launch-workspace",
    "allow-nexus-consult-ai-doctor",
    "allow-nexus-list-sessions",
    "allow-nexus-resume-session",
    "allow-nexus-delete-session",
    "allow-nexus-usage-insights",
    "allow-nexus-get-account",
    "allow-nexus-switch-account-tier",
    "allow-nexus-list-sync-devices",
    "allow-nexus-trigger-sync",
    "allow-nexus-resolve-sync-conflict",
    "allow-nexus-export-account-bundle",
    "allow-nexus-purge-cloud-sync"
  ]
}
